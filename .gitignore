# This public repository deliberately tracks only its release files.
# Personal exports, backups, non-demo screenshots and arbitrary local files stay ignored.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/build.py
!/demo_data.py
!/index.html
!/src/
!/tests/
!/docs/
/src/*
!/src/app.template.html
!/src/abandonment.js
!/src/company-notes.js
!/src/ideal-company-insights.js
!/src/insights.css
!/src/insights.js
!/src/note-format.js
!/src/note-history.js
!/src/stage-chronology.js
!/src/workflow-rules.js
/tests/*
!/tests/smoke.cjs
!/tests/capture-readme.cjs
/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/01-board.png
!/docs/screenshots/02-stage-results.png
!/docs/screenshots/03-company-detail.png
!/docs/screenshots/04-stage-transition.png
!/docs/screenshots/05-specialty-filter.png
!/docs/screenshots/06-status-distribution.png
!/docs/screenshots/07-ideal-companies.png
!/docs/screenshots/08-schedule.png
!/docs/screenshots/09-field-settings.png
!/docs/screenshots/10-import.png
